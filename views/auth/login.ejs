<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Employee Sign In | FaceAI Attend</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/shared/styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body class="auth-page">
  <div class="auth-particles" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
  <header class="auth-top-nav">
    <a href="/login" class="brand-block auth-brand">
      <span class="brand-mark"><i class="fa-solid fa-shield-halved"></i></span>
      <span><strong>FaceAI Attend</strong><small>Smart Attendance & Work Tracking</small></span>
    </a>
    //<a href="/admin-login" class="admin-login-glow"><i class="fa-solid fa-user-shield"></i> Admin Sign In</a>
  </header>

  <main class="auth-shell enterprise-auth-shell tab-auth-shell">
    <section class="auth-panel split-auth-panel employee-auth-tabs reveal" aria-labelledby="employee-auth-title">
      <div class="employee-auth-header">
        <div>
          <span class="status-chip"><span class="live-dot"></span> Secure employee sign in</span>
          <h1 id="employee-auth-title">Employee Sign In</h1>
          <p>Use your password or face scan to open your employee overview.</p>
        </div>
        <div class="auth-security-strip compact">
          <span><i class="fa-solid fa-key"></i> Secure Sign-In Sessions</span>
          <span><i class="fa-solid fa-shield-virus"></i> Protected Services</span>
        </div>
      </div>

      <div class="auth-tab-list" role="tablist" aria-label="Employee login methods">
        <button type="button" class="auth-tab is-active" id="password-login-tab" role="tab" aria-selected="true" aria-controls="password-login-panel" data-auth-tab="password">
          <i class="fa-solid fa-lock"></i>
          <span>Password Sign In</span>
        </button>
        <button type="button" class="auth-tab" id="face-login-tab" role="tab" aria-selected="false" aria-controls="face-login-panel" data-auth-tab="face">
          <i class="fa-solid fa-face-smile"></i>
          <span>Face Scan Sign In</span>
        </button>
      </div>

      <div class="auth-tab-panels">
        <section class="auth-tab-panel employee-password-panel is-active" id="password-login-panel" role="tabpanel" aria-labelledby="password-login-tab" data-auth-panel="password">
          <div class="auth-method-copy">
            <span class="status-chip"><i class="fa-solid fa-id-badge"></i> Employee ID / Email</span>
            <h2>Password Sign In</h2>
            <p>Enter your employee ID or email and password to open your work account.</p>
          </div>
          <% if (error) { %><p class="form-status status-error"><%= error %></p><% } %>
          <form class="stack-form auth-form" id="employee-password-login-form" action="/login" method="POST" novalidate>
            <input type="hidden" name="next" value="<%= nextUrl %>">
            <label><span>Employee ID / Email</span><input type="text" name="email" placeholder="EMP-1042 or employee@company.com" required></label>
            <label class="password-field"><span>Password</span><input id="employee-login-password" type="password" name="password" placeholder="Enter password" required></label>
            <div class="auth-options-row">
              <label class="check-control"><input type="checkbox" name="remember"> <span>Remember Me</span></label>
              <label class="check-control"><input type="checkbox" class="show-password-toggle" data-target="employee-login-password"> <span>Show Password</span></label>
              <a href="/forgot-password">Forgot Password</a>
            </div>
            <button class="btn btn-primary wide" type="submit"><i class="fa-solid fa-right-to-bracket"></i> Sign In</button>
            <button class="btn btn-secondary wide" type="button" id="credential-start-face-login"><i class="fa-solid fa-face-smile"></i> Sign In with Face Recognition</button>
            <p id="employee-login-form-status" class="form-status">Enter your employee ID or email and password to sign in.</p>
          </form>
          <p class="auth-switch">Need access? <a href="/signup">Create Employee Account</a></p>
          <div class="auth-security-strip">
            <span><i class="fa-solid fa-lock"></i> Protected Passwords</span>
            <span><i class="fa-solid fa-user-clock"></i> Secure Sign In</span>
          </div>
        </section>

        <section class="auth-tab-panel employee-face-login" id="face-login-panel" role="tabpanel" aria-labelledby="face-login-tab" data-auth-panel="face" hidden>
          <div class="auth-method-copy">
            <span class="status-chip"><span class="live-dot"></span> Face scan access</span>
            <h2>Face Scan Sign In</h2>
            <p>Keep your face centered with good lighting. The system will confirm you are present and match your face.</p>
          </div>

          <p id="employee-face-login-status" class="form-status face-login-status-top">Start the camera, then keep your face inside the frame to sign in securely.</p>
          <div class="face-login-instructions" aria-label="Face scan instructions">
            <span><i class="fa-solid fa-lightbulb"></i> Sit in clear light.</span>
            <span><i class="fa-solid fa-user"></i> Keep one face centered.</span>
            <span><i class="fa-solid fa-eye"></i> Look at the camera and avoid blur.</span>
          </div>

          <div class="camera-shell face-login-shell">
            <div class="scan-stage-layout">
              <div class="camera-frame scanner-frame biometric-camera">
                <video id="employee-login-camera-feed" autoplay playsinline muted></video>
                <canvas id="employee-login-camera-canvas" hidden></canvas>
                <span class="camera-reticle"></span>
                <span class="scan-line camera-scan"></span>
                <span class="face-mesh-overlay" aria-hidden="true"></span>
                <span class="face-box" id="employee-login-face-box" hidden></span>
                <div class="scanner-state" id="employee-login-scanner-state">Camera ready</div>
                <div class="face-guide"><span></span><span></span><span></span><span></span></div>
              </div>
              <div class="face-scan-progress" id="login-scan-progress" data-state="idle" aria-label="Face sign-in progress">
                <div class="face-scan-progress-head"><span>FACE MATCH</span><strong id="login-scan-progress-value">0%</strong></div>
                <div class="face-scan-progress-track"><span id="login-scan-progress-fill"></span></div>
                <small id="login-scan-progress-label">Ready to scan</small>
              </div>
            </div>
            <div class="quality-grid">
              <div><strong id="employee-login-confidence">Match Accuracy 0.0%</strong><span>Face match accuracy</span></div>
              <div><strong id="employee-login-state">Real person check ready</strong><span>Real person and face position check</span></div>
              <div><strong id="employee-login-light-state">Lighting pending</strong><span>Lighting check</span></div>
              <div><strong id="employee-login-quality-state">Quality pending</strong><span>Blur and clarity check</span></div>
            </div>
            <div class="auth-feature-grid">
              <span><i class="fa-solid fa-video"></i> Live Camera Preview</span>
              <span><i class="fa-solid fa-crosshairs"></i> Smart Face Detection</span>
              <span><i class="fa-solid fa-vector-square"></i> Face Position Guide</span>
              <span><i class="fa-solid fa-user-check"></i> Real Person Check</span>
            </div>
            <div class="camera-controls">
              <button type="button" id="start-employee-face-login" class="btn btn-primary"><i class="fa-solid fa-fingerprint"></i> Start Face Scan</button>
              <button type="button" id="retry-employee-face-login" class="btn btn-secondary"><i class="fa-solid fa-rotate-right"></i> Scan Again</button>
            </div>
            <p id="employee-face-login-loader" class="loading-skeleton face-login-inline-loader" hidden></p>
          </div>
        </section>
      </div>
    </section>
  </main>
  <div class="toast-stack" id="toast-stack"></div>
  <script src="/js/shared/script.js"></script>
</body>
</html>
