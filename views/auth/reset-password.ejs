<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password | FaceAI Attend</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/shared/styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
</head>
<body class="auth-page">
  <main class="auth-shell">
    <section class="auth-panel reveal password-recovery-card">
      <span class="status-chip"><i class="fa-solid fa-key"></i> Password reset</span>
      <h1>Create New Password</h1>
      <% if (error) { %><p class="form-status status-error"><%= error %></p><% } %>
      <% if (success) { %><p class="form-status status-success"><%= success %></p><a href="/login" class="btn btn-primary wide">Sign In</a><% } %>
      <% if (token) { %>
        <form class="stack-form auth-form" action="/reset-password/<%= token %>" method="POST">
          <label><span>New Password</span><input type="password" name="password" minlength="8" autocomplete="new-password" required></label>
          <label><span>Confirm New Password</span><input type="password" name="confirmPassword" minlength="8" autocomplete="new-password" required></label>
          <button class="btn btn-primary wide" type="submit"><i class="fa-solid fa-lock"></i> Update Password</button>
        </form>
      <% } else if (!success) { %><a href="/forgot-password" class="btn btn-primary wide">Request Another Link</a><% } %>
    </section>
  </main>
</body>
</html>
