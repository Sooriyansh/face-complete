<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password | FaceAI Attend</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/shared/styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
</head>
<body class="auth-page">
  <main class="auth-shell">
    <section class="auth-panel reveal password-recovery-card">
      <span class="status-chip"><i class="fa-solid fa-shield-halved"></i> Secure account recovery</span>
      <h1>Forgot Password?</h1>
      <p>Enter the email linked to your account. We will send a one-time reset link valid for 60 minutes.</p>
      <% if (error) { %><p class="form-status status-error"><%= error %></p><% } %>
      <% if (success) { %><p class="form-status status-success"><%= success %></p><% } %>
      <form class="stack-form auth-form" action="/forgot-password" method="POST">
        <label><span>Email Address</span><input type="email" name="email" autocomplete="email" placeholder="employee@company.com" required></label>
        <button class="btn btn-primary wide" type="submit"><i class="fa-solid fa-paper-plane"></i> Send Reset Link</button>
      </form>
      <a href="/login" class="btn btn-secondary wide"><i class="fa-solid fa-arrow-left"></i> Back to Sign In</a>
    </section>
  </main>
</body>
</html>
