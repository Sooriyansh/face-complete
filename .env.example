FACEAI_COLLECTOR_TOKEN=<long-random-collector-token>
FACEAI_EMPLOYEE_ID=<employee-roll-number>
FACEAI_EMPLOYEE_NAME=<employee-name>
FACEAI_IDLE_THRESHOLD_SECONDS=120
FACEAI_POLL_INTERVAL_SECONDS=15

