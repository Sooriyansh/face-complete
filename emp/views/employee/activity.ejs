<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Activity History | FaceAI Attend</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/shared/styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body data-role="<%= currentUser ? currentUser.role : 'employee' %>">
  <% const safeEvents = typeof personalEvents !== 'undefined' ? personalEvents : []; %>
  <% const fmtMs = (ms) => { const total = Math.max(Math.floor(Number(ms || 0) / 60000), 0); const h = Math.floor(total / 60); const m = total % 60; return h ? `${h}h ${m}m` : `${m}m`; }; %>
  <% const fmtTime = (value) => value ? new Date(value).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '-'; %>
  <div class="enterprise-layout employee-layout">
    <%- include('partials/sidebar', { activePage: 'activity' }) %>
    <main class="workspace">
      <%- include('partials/topbar', { syncLabel: 'Activity logs' }) %>
      <section class="page-hero reveal"><div><span class="status-chip"><span class="live-dot"></span>My activity timeline</span><h1>My Activity History</h1><p>Review website login/logout, sleep mode duration, wakeups, and shutdown records.</p></div></section>
      <section class="metric-grid compact reveal">
        <div class="metric-card"><span class="metric-icon"><i class="fa-solid fa-right-to-bracket"></i></span><p>Sign In History</p><strong id="metric-signin-count"><%= typeof signInCount !== 'undefined' ? signInCount : 0 %></strong></div>
        <div class="metric-card"><span class="metric-icon"><i class="fa-solid fa-power-off"></i></span><p>Shutdown / Restart</p><strong><%= typeof powerEventCount !== 'undefined' ? powerEventCount : 0 %></strong></div>
        <div class="metric-card"><span class="metric-icon violet"><i class="fa-solid fa-bed"></i></span><p>Sleep/Wake</p><strong id="metric-sleep-count"><%= typeof sleepWakeCount !== 'undefined' ? sleepWakeCount : 0 %></strong></div>
        <div class="metric-card"><span class="metric-icon success"><i class="fa-solid fa-clock-rotate-left"></i></span><p>Total Activities</p><strong id="metric-total-activities"><%= typeof totalActivityCount !== 'undefined' ? totalActivityCount : (safeEvents ? safeEvents.length : 0) %></strong></div>
      </section>
      <section class="metric-grid compact reveal">
        <div class="metric-card"><span class="metric-icon success"><i class="fa-solid fa-signal"></i></span><p>Current Status</p><strong id="employee-current-status"><%= currentStatus || 'Not connected' %></strong></div>
        <div class="metric-card"><span class="metric-icon"><i class="fa-solid fa-moon"></i></span><p>Sleep Time</p><strong><%= fmtMs(typeof todaySleepMs !== 'undefined' ? todaySleepMs : 0) %></strong></div>
        <div class="metric-card"><span class="metric-icon violet"><i class="fa-solid fa-desktop"></i></span><p>Desktop Agent</p><strong id="employee-agent-status"><%= desktopAgentStatus || 'Not connected' %></strong></div>
        <div class="metric-card"><span class="metric-icon"><i class="fa-solid fa-computer"></i></span><p>Machine Status</p><strong id="employee-machine-status"><%= machineStatus || 'Unknown' %></strong></div>
      </section>
      <section class="metric-grid compact reveal">
        <div class="metric-card"><span class="metric-icon success"><i class="fa-solid fa-business-time"></i></span><p>Today's Working Time</p><strong id="employee-working-time"><%= fmtMs(todayWorkingMs) %></strong></div>
        <div class="metric-card"><span class="metric-icon"><i class="fa-solid fa-right-to-bracket"></i></span><p>Login Time</p><strong><%= fmtTime(loginTime) %></strong></div>
        <div class="metric-card"><span class="metric-icon violet"><i class="fa-solid fa-right-from-bracket"></i></span><p>Logout Time</p><strong><%= fmtTime(logoutTime) %></strong></div>
        <div class="metric-card"><span class="metric-icon"><i class="fa-solid fa-right-from-bracket"></i></span><p>Login / Logout</p><strong id="employee-login-logout"><%= fmtTime(loginTime) %> / <%= fmtTime(logoutTime) %></strong></div>
      </section>
      <section class="metric-grid compact reveal">
        <div class="metric-card"><span class="metric-icon"><i class="fa-solid fa-briefcase"></i></span><p>Join Work Time</p><strong><%= fmtTime(joinWorkTime) %></strong></div>
        <div class="metric-card"><span class="metric-icon"><i class="fa-solid fa-door-open"></i></span><p>Leave Work Time</p><strong><%= fmtTime(leaveWorkTime) %></strong></div>
        <div class="metric-card"><span class="metric-icon violet"><i class="fa-solid fa-moon"></i></span><p>Sleep History</p><strong><%= safeEvents.filter((event) => ['Sleep', 'Wake', 'Wakeup', 'System Wake'].includes(event.event)).length %></strong></div>
        <div class="metric-card"><span class="metric-icon success"><i class="fa-solid fa-plug-circle-xmark"></i></span><p>Shutdown Events</p><strong><%= safeEvents.filter((event) => ['Shutdown', 'System Shutdown', 'Unexpected Shutdown', 'Abrupt Shutdown', 'Restart', 'System Restart'].includes(event.event)).length %></strong></div>
      </section>
      <section class="panel reveal" id="personal-events">
        <div class="panel-header"><div><p class="eyebrow">My Activity Timeline</p><h2>My Activity History</h2></div></div>
        <div class="timeline-stream">
          <% if (safeEvents.length === 0) { %><div><span class="event-dot"></span><strong>No activity recorded yet</strong><p>Website login/logout, startup, shutdown, sleep, and wake activity will appear here.</p></div><% } %>
          <% safeEvents.forEach((event) => { %><div><span class="event-dot"></span><strong><%= event.event %></strong><p><%= new Date(event.occurredAt).toLocaleString() %> - <%= event.meaning || event.sourceLog || 'System event' %></p></div><% }) %>
        </div>
      </section>
    </main>
  </div>
  <%- include('partials/scripts') %>
</body>
</html>
