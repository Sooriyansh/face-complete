<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Activity History | FaceAI Attend</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/shared/styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body data-role="admin">
  <% const safeSystemEvents = typeof systemEvents !== 'undefined' ? systemEvents : []; %>
  <% const safeStudents = typeof students !== 'undefined' ? students : []; %>
  <% const safeEmployeeStatuses = typeof employeeStatuses !== 'undefined' ? employeeStatuses : []; %>
  <% const statusByEmployee = new Map(safeEmployeeStatuses.map((row) => [String(row.employeeId), row])); %>
  <% const safeRange = typeof systemEventRange !== 'undefined' ? systemEventRange : null; %>
  <div class="enterprise-layout">
    <aside class="side-nav">
      <a href="/admin/dashboard" class="brand-block"><span class="brand-mark"><i class="fa-solid fa-shield-halved"></i></span><span><strong>FaceAI</strong><small>Security Timeline</small></span></a>
      <nav class="side-menu">
        <a href="/admin/dashboard"><i class="fa-solid fa-grid-2"></i>Overview</a>
        <a href="/admin/attendance"><i class="fa-solid fa-calendar-check"></i>Attendance</a>
        <a href="/admin/employees"><i class="fa-solid fa-users-gear"></i>Employees</a>
        <a class="active" href="/admin/system-events"><i class="fa-solid fa-timeline"></i>Activity History</a>
      </nav>
      <div class="rbac-card"><span class="security-badge">Admin access</span><p>Filter any registered employee and inspect complete device, login, lock, attendance, and live activity history.</p></div>
      <form action="/logout" method="POST" class="logout-form"><button type="submit">Logout</button></form>
    </aside>

    <main class="workspace">
      <header class="topbar">
        <button class="mobile-menu-toggle" type="button" aria-label="Open navigation"><i class="fa-solid fa-bars"></i></button>
        <label class="search-box"><i class="fa-solid fa-magnifying-glass"></i><input id="event-search" type="search" placeholder="Search employee or event"></label>
        <div class="topbar-actions">
          <span class="sync-pill"><span class="live-dot"></span>Live updates on</span>
          <span class="clock" id="real-time-clock">--:--</span>
          <span class="security-badge"><%= currentUser ? currentUser.role : 'admin' %></span>
        </div>
      </header>

      <section class="page-hero reveal">
        <div>
          <span class="status-chip"><span class="live-dot"></span> Live security timeline dashboard</span>
          <h1>Activity History</h1>
          <p>Track employee Windows device activity and work sessions in real time.</p>
        </div>
        <div class="hero-actions">
          <button id="refresh-system-events" class="btn btn-primary"><i class="fa-solid fa-rotate-right"></i> Refresh Activity</button>
          <label class="toggle-pill"><input type="checkbox" id="realtime-system-events" checked> Live</label>
          <button class="btn btn-secondary" id="export-system-events" type="button"><i class="fa-solid fa-file-export"></i> Export Records</button>
        </div>
      </section>

      <section class="control-panel reveal">
        <div class="filter-controls"><label>Search by Date</label><input type="date" id="system-events-date"></div>
        <div class="filter-controls all-users-control">
          <label for="user-filter">Search by Employee</label>
          <select id="user-filter"><option value="">All Employees</option><% safeStudents.forEach((student) => { %><option value="<%= student._id %>"><%= student.name %> (<%= student.rollNumber || student.faceLabel %>)</option><% }) %></select>
        </div>
        <div class="filter-controls"><label>Department</label><select id="department-filter"><option value="">All departments</option><% [...new Set(safeStudents.map((s) => s.department).filter(Boolean))].forEach((department) => { %><option><%= department %></option><% }) %></select></div>
        <div class="filter-controls"><label>&nbsp;</label><button id="system-events-search" class="btn btn-primary" type="button"><i class="fa-solid fa-magnifying-glass"></i> Search</button></div>
        <div class="filter-controls"><label>&nbsp;</label><button id="system-events-reset" class="btn btn-secondary" type="button"><i class="fa-solid fa-rotate-left"></i> Reset</button></div>
      </section>

      <section class="metric-grid compact reveal">
        <div class="metric-card"><span class="metric-icon"><i class="fa-solid fa-clock"></i></span><p>Tracking Window</p><strong id="system-events-range"><% if (safeRange) { %><%= new Date(safeRange.start).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %> - <%= new Date(safeRange.end).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %><% } else { %>08:00 - Now<% } %></strong></div>
        <div class="metric-card"><span class="metric-icon"><i class="fa-solid fa-bolt"></i></span><p>Total Events</p><strong id="system-events-count"><%= safeSystemEvents.length %></strong></div>
        <div class="metric-card"><span class="metric-icon violet"><i class="fa-solid fa-lock"></i></span><p>Lock/Unlock</p><strong id="system-events-lock-count">0</strong></div>
        <div class="metric-card"><span class="metric-icon success"><i class="fa-solid fa-satellite-dish"></i></span><p>Live Sync Status</p><strong id="system-events-sync">Waiting</strong></div>
      </section>

      <section class="metric-grid compact reveal">
        <div class="metric-card"><span class="metric-icon success"><i class="fa-solid fa-right-to-bracket"></i></span><p>Sign In</p><strong id="system-events-signin-count">0</strong></div>
        <div class="metric-card"><span class="metric-icon"><i class="fa-solid fa-right-from-bracket"></i></span><p>Sign Out</p><strong id="system-events-signout-count">0</strong></div>
        <div class="metric-card"><span class="metric-icon violet"><i class="fa-solid fa-moon"></i></span><p>Sleep/Wake</p><strong id="system-events-sleep-count">0</strong></div>
        <div class="metric-card"><span class="metric-icon"><i class="fa-solid fa-hourglass-half"></i></span><p>Active / Idle</p><strong id="system-events-active-idle">0m / 0m</strong></div>
      </section>

      <section class="event-type-grid reveal" id="system-event-type-filters">
        <button type="button" class="event-type-card" data-event-filter="Startup"><i class="fa-solid fa-power-off"></i><strong>Startup</strong><span>Boot detection</span></button>
        <button type="button" class="event-type-card" data-event-filter="Shutdown"><i class="fa-solid fa-plug-circle-xmark"></i><strong>Shutdown</strong><span>Power-off log</span></button>
        <button type="button" class="event-type-card" data-event-filter="Sleep,Wakeup,System Wake"><i class="fa-solid fa-moon"></i><strong>Sleep/Wakeup</strong><span>Session continuity</span></button>
        <button type="button" class="event-type-card" data-event-filter="Windows Sign In,Windows Sign Out,Login,Logout,User Session Start,User Session End,Session Connect,Session Disconnect"><i class="fa-solid fa-right-to-bracket"></i><strong>Sign In/Logout</strong><span>User access</span></button>
        <button type="button" class="event-type-card" data-event-filter="Screen Lock,Screen Unlock,Lock,Unlock"><i class="fa-solid fa-lock"></i><strong>Lock/Unlock</strong><span>Screen security</span></button>
        <button type="button" class="event-type-card" data-event-filter="Active Application,Application Switch,Website Visited,Application Started,Application Stopped"><i class="fa-solid fa-window-restore"></i><strong>Apps/Websites</strong><span>Foreground usage</span></button>
      </section>

      <section class="admin-grid reveal">
        <div class="panel">
          <div class="panel-header"><div><p class="eyebrow">User filter section</p><h2>Registered Employees</h2></div></div>
          <div class="employee-filter-list">
            <% if (safeStudents.length === 0) { %><p class="helper-text">No registered employees yet.</p><% } %>
            <% safeStudents.forEach((student) => { %>
              <% const employeeStatus = statusByEmployee.get(String(student._id)) || { status: 'Offline', lastActivityAt: null, activeApplication: '' }; %>
              <button class="employee-filter-card" type="button" data-user="<%= student._id %>" data-department="<%= student.department || '' %>" data-status="<%= employeeStatus.status %>">
                <span class="avatar"><%= student.name.slice(0,2).toUpperCase() %></span>
                <span><strong><%= student.name %></strong><small><%= student.department || 'General' %> - Last active <%= employeeStatus.lastActivityAt ? new Date(employeeStatus.lastActivityAt).toLocaleString() : 'not recorded' %><% if (employeeStatus.activeApplication) { %> - <%= employeeStatus.activeApplication %><% } %></small></span>
                <span class="<%= employeeStatus.status === 'Online' ? 'status-online' : 'status-offline' %>"><%= employeeStatus.status %></span>
              </button>
            <% }) %>
          </div>
        </div>
        <div class="panel">
          <div class="panel-header"><div><p class="eyebrow">Live feed</p><h2>Activity Feed</h2></div></div>
          <div class="activity-feed realtime-feed" id="system-events-live-feed">
            <% if (safeSystemEvents.length === 0) { %>
              <div><span class="live-dot"></span><strong>No activity recorded yet</strong><p>Waiting for Windows agent or attendance activity.</p></div>
            <% } %>
            <% safeSystemEvents.slice(0, 5).forEach((event) => { %>
              <div>
                <span class="live-dot"></span>
                <strong><%= event.employeeName || event.user || 'Unknown employee' %> - <%= event.event %></strong>
                <p><%= new Date(event.occurredAt).toLocaleString() %> - <%= event.meaning || event.provider || event.sourceLog || '-' %></p>
              </div>
            <% }) %>
          </div>
        </div>
      </section>

      <section class="panel reveal">
        <div class="panel-header split">
          <div>
            <p class="eyebrow">Timeline</p>
            <h2>Complete Activity Timeline</h2>
            <p id="system-events-status" class="helper-text">Select an employee to show only that employee's attendance history, system events, device activity, login/logout logs, and lock/unlock history.</p>
          </div>
          <span class="panel-badge">Live events stream</span>
        </div>
        <div class="timeline-stream" id="system-events-body">
          <% if (safeSystemEvents.length === 0) { %><div><span class="event-dot"></span><strong>No activity recorded yet</strong><p>Waiting for device activity updates.</p></div><% } %>
          <% safeSystemEvents.forEach((event) => { %>
            <div class="event-row" data-user="<%= event.user || event.employeeName || 'Unknown' %>">
              <span class="event-dot"></span>
              <strong><%= event.user || event.employeeName || 'Unknown' %> - <%= event.event %></strong>
              <p><%= new Date(event.occurredAt).toLocaleString() %> - <%= event.meaning || event.provider || event.sourceLog || '-' %> - Activity ID <%= event.eventId %></p>
            </div>
          <% }) %>
        </div>
      </section>
    </main>
  </div>
  <div class="toast-stack" id="toast-stack"></div>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/shared/script.js"></script>
</body>
</html>
