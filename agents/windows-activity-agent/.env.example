# Leave blank to auto-detect from FACEAI_PUBLIC_URL/PUBLIC_URL/APP_URL/BASE_URL,
# Render/Railway/Vercel host env vars, or local PORT. Explicit value wins.
FACEAI_SERVER_URL=

# Leave blank to reuse SYSTEM_EVENTS_COLLECTOR_TOKEN from the main server .env.
FACEAI_COLLECTOR_TOKEN=

# Leave blank to use the current Windows user.
FACEAI_EMPLOYEE_ID=
FACEAI_EMPLOYEE_NAME=

# Leave blank to use <hostname>-<windows-user>.
FACEAI_AGENT_ID=

# User ko idle (inactive) tab maana jayega jab itne seconds tak
# mouse ya keyboard se koi activity na ho.
# 600 = 10 minutes
FACEAI_IDLE_THRESHOLD_SECONDS=600

# Application har itne seconds baad system ko check karegi
# (user activity, idle status, event collection, etc.).
# 60 = har 60 seconds me ek check.
FACEAI_POLL_INTERVAL_SECONDS=60

# Windows Event Log se pichhle itne seconds ke events padhe jayenge.
# 600 = last 10 minutes ke events.
FACEAI_EVENTLOG_LOOKBACK=600
